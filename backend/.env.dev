# Development Environment Configuration
NODE_ENV="development"
PORT="3001"
API_VERSION="v1"

# Database (using SQLite for development)
DATABASE_URL="file:./dev.db"

# Redis (optional for development)
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_SECRET="development-jwt-secret-key-32-chars-long"
JWT_REFRESH_SECRET="development-refresh-secret-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption
ENCRYPTION_KEY="development-encryption-key-32-chars"

# CORS
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3001"

# Stripe (test keys for development)
STRIPE_SECRET_KEY="sk_test_development_key_replace_with_real"
STRIPE_PUBLISHABLE_KEY="pk_test_development_key_replace_with_real"
STRIPE_WEBHOOK_SECRET="whsec_development_key_replace_with_real"

# Email (using Etherreal for development)
ETHEREAL_USER="restinu-dev@ethereal.email"
ETHEREAL_PASS="development_email_password"
FROM_EMAIL="noreply@restinu.dev"

# Google Maps (optional for development)
GOOGLE_MAPS_API_KEY="development_google_maps_key"

# AI Services
PYTHON_AI_URL="http://localhost:5000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"