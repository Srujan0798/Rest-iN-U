// REST-iN-U Development Database Schema
// PostgreSQL version for local development

generator client {
  provider = "prisma-client-js"
}

generator pyclient {
  provider = "prisma-client-py"
  interface = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTHENTICATION ====================

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  profilePhotoUrl   String?
  userType          UserType   @default(BUYER)
  dateOfBirth       DateTime?
  birthTime         String? // For astrological calculations
  birthPlace        String? // For astrological calculations
  kycVerified       Boolean    @default(false)
  kycDocuments      Json?
  walletAddress     String? // Blockchain wallet
  preferredLanguage String     @default("en")
  timezone          String?
  doshaType         DoshaType? // Ayurvedic constitution
  lifePathNumber    Int? // Numerology
  stripeCustomerId  String? // Stripe customer ID for billing
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?
  isActive          Boolean    @default(true)

  // Relations
  agent            Agent?
  savedSearches    SavedSearch[]
  favorites        Favorite[]
  leads            Lead[]         @relation("BuyerLeads")
  messages         Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  reviews          Review[]       @relation("ReviewAuthor")
  propertyViews    PropertyView[]
  notifications    Notification[]
  analysisRequests AnalysisJob[]  @relation("AnalysisRequests")

  @@index([email])
  @@index([userType])
  @@index([walletAddress])
}

enum UserType {
  BUYER
  SELLER
  AGENT
  ADMIN
  INVESTOR
}

enum DoshaType {
  VATA
  PITTA
  KAPHA
  VATA_PITTA
  PITTA_KAPHA
  VATA_KAPHA
  TRIDOSHA
}

// ==================== AGENT ====================

model Agent {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  licenseNumber       String
  licenseState        String?
  licenseExpiry       DateTime?
  brokerage           String?
  brokerageAddress    String?
  yearsExperience     Int       @default(0)
  specialties         String[]
  serviceAreas        String[]
  languages           String[]
  bio                 String?
  websiteUrl          String?
  linkedinUrl         String?
  rating              Float     @default(0)
  reviewCount         Int       @default(0)
  ethicsScore         Float? // Based on spiritual principles
  subscriptionTier    String?   @default("BASIC")
  subscriptionExpires DateTime?
  verified            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  properties       Property[]
  leads            Lead[]
  reviews          Review[]            @relation("AgentReviews")
  agentPerformance AgentPerformance[]
  availability     AgentAvailability[]

  @@index([rating])
  @@index([verified])
  @@index([subscriptionTier])
}

// ==================== PROPERTY ====================

model Property {
  id             String  @id @default(uuid())
  mlsId          String? @unique
  listingAgentId String?
  listingAgent   Agent?  @relation(fields: [listingAgentId], references: [id])

  // Basic Info
  title        String
  description  String
  propertyType PropertyType
  listingType  ListingType
  status       PropertyStatus @default(ACTIVE)

  // Location
  streetAddress String
  unit          String?
  city          String
  state         String
  zipCode       String
  country       String  @default("USA")
  latitude      Float
  longitude     Float

  // Property Details
  price            Float
  originalPrice    Float?
  pricePerSqft     Float?
  bedrooms         Int
  bathrooms        Float
  squareFeet       Int?
  lotSizeAcres     Float?
  yearBuilt        Int?
  stories          Int?
  parkingSpaces    Int?
  garageSpaces     Int?
  constructionDate DateTime? // For Kundali matching

  // Features
  features         String[]
  amenities        String[]
  appliances       String[]
  flooring         String[]
  heating          String[]
  cooling          String[]
  roofType         String?
  exteriorMaterial String?
  foundationType   String?

  // Media
  photos         PropertyPhoto[]
  virtualTourUrl String?
  videoUrl       String?
  floorPlanUrl   String?

  // Financial
  hoaFee            Float?
  hoaFrequency      String? // monthly, quarterly, annual
  propertyTax       Float?
  taxYear           Int?
  estimatedMortgage Float?

  // Dates
  listedDate   DateTime  @default(now())
  soldDate     DateTime?
  closingDate  DateTime?
  daysOnMarket Int       @default(0)

  // Stats
  viewCount     Int @default(0)
  favoriteCount Int @default(0)
  inquiryCount  Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vastuAnalysis   VastuAnalysis?
  climateAnalysis ClimateAnalysis?
  analysisJobs    AnalysisJob[]
  leads           Lead[]
  favorites       Favorite[]
  views           PropertyView[]
  Message         Message[]

  @@index([city, state])
  @@index([price])
  @@index([propertyType])
  @@index([status])
  @@index([bedrooms, bathrooms])
}

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOUSE
  APARTMENT
  LAND
  MULTI_FAMILY
  COMMERCIAL
  VILLA
  PENTHOUSE
  FARMHOUSE
  ASHRAM
  PLOT
}

enum ListingType {
  SALE
  RENT
  LEASE
  AUCTION
}

enum PropertyStatus {
  ACTIVE
  PENDING
  SOLD
  OFF_MARKET
  COMING_SOON
}

// ==================== PROPERTY PHOTOS ====================

model PropertyPhoto {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  caption      String?
  roomType     String?
  orderIndex   Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([propertyId, isPrimary])
  @@index([propertyId, orderIndex])
}

// ==================== VASTU ANALYSIS ====================

model VastuAnalysis {
  id                String   @id @default(uuid())
  propertyId        String   @unique
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Scoring
  overallScore      Int      // 0-100
  grade             String   // A+, A, B+, B, C, D, F

  // Directional Analysis
  entranceDirection String?  // N, NE, E, SE, S, SW, W, NW
  facingDirection   String?  // Main facing direction
  elements          Json     // {fire, water, earth, air, space scores}
  directions        Json     // {north, south, east, west analysis}

  // Room-wise Analysis
  roomAnalysis      Json?    // Array of {room, score, issues}

  // Defects & Remedies
  defects           Json?    // Array of {room, issue, severity, impact}
  remedies          Json?    // Array of {defect, remedy, cost, priority}
  recommendations   String[]

  // Metadata
  analyzedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([overallScore])
  @@index([grade])
}

// ==================== CLIMATE ANALYSIS ====================

model ClimateAnalysis {
  id                  String   @id @default(uuid())
  propertyId          String   @unique
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Overall Risk Assessment
  overallRiskScore    Int      // 0-100 (higher = more risk)
  riskGrade           String   // A (low risk), B, C, D, F (high risk)

  // Individual Risk Scores (0-100)
  floodRiskScore      Int?
  fireRiskScore       Int?
  earthquakeRiskScore Int?
  hurricaneRiskScore  Int?
  tornadoRiskScore    Int?
  droughtRiskScore    Int?
  heatRiskScore       Int?

  // Flood Data
  floodZone           String?  // X, A, AE, V, VE, etc.
  floodZoneDescription String?

  // Fire Data
  fireZone            String?  // WUI zone classification
  vegetationType      String?

  // Seismic Data
  seismicZone         String?
  faultProximity      Float?   // Distance to nearest fault in miles

  // Historical Events
  historicalEvents    Json?    // Array of past climate events in area

  // Insurance Implications
  insuranceNotes      String[]
  estimatedPremiumImpact String? // LOW, MODERATE, HIGH, VERY_HIGH

  // Mitigation Recommendations
  mitigations         Json?    // Array of {risk, recommendation, cost, priority}

  // Data Sources
  dataSources         String[] // FEMA, USGS, etc.
  dataFreshness       DateTime? // When climate data was last updated

  // Metadata
  analyzedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([overallRiskScore])
  @@index([riskGrade])
  @@index([floodZone])
}

// ==================== FAVORITES ====================

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

// ==================== LEADS ====================

model Lead {
  id         String     @id @default(uuid())
  propertyId String
  agentId    String
  userId     String?
  property   Property   @relation(fields: [propertyId], references: [id])
  agent      Agent?     @relation(fields: [agentId], references: [id])
  user       User?      @relation("BuyerLeads", fields: [userId], references: [id])
  name       String
  email      String
  phone      String?
  message    String?
  status     LeadStatus @default(NEW)
  source     String     @default("WEBSITE")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([agentId, status])
  @@index([propertyId])
}

enum LeadStatus {
  NEW
  CONTACTED
  SHOWING_SCHEDULED
  OFFER_MADE
  CLOSED
  LOST
}

// ==================== ANALYSIS JOB ====================

model AnalysisJob {
  id            String    @id @default(uuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById String
  requester     User      @relation("AnalysisRequests", fields: [requestedById], references: [id])
  analysisTypes String[] // ['VASTU', 'FENG_SHUI', 'CLIMATE', etc.]
  priority      Priority  @default(MEDIUM)
  status        JobStatus @default(PENDING)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  results       Json? // Analysis results from different agents
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([propertyId, status])
  @@index([requestedById, status])
  @@index([status, priority])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== REVIEWS ====================

model Review {
  id              String   @id @default(uuid())
  agentId         String
  agent           Agent?   @relation("AgentReviews", fields: [agentId], references: [id])
  reviewerId      String
  reviewer        User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  rating          Int // 1-5 stars
  title           String?
  comment         String?
  transactionType String? // SALE, RENT, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId, rating])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional data
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  NEW_LISTING
  PRICE_CHANGE
  NEW_LEAD
  MESSAGE
  SHOWING_REMINDER
  OFFER_RECEIVED
  DOCUMENT_READY
  AUSPICIOUS_DATE
  CLIMATE_ALERT
  VASTU_ALERT
  DAO_PROPOSAL
}

// ==================== PROPERTY VIEWS ====================

model PropertyView {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  viewedAt   DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
}

// ==================== SAVED SEARCHES ====================

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json // Search criteria as JSON
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

// ==================== AGENT AVAILABILITY ====================

model AgentAvailability {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String // HH:MM format
  endTime   String // HH:MM format
  status    String   @default("AVAILABLE") // AVAILABLE, BOOKED, UNAVAILABLE
  notes     String?
  createdAt DateTime @default(now())

  @@index([agentId, date])
}

// ==================== AGENT PERFORMANCE ====================

model AgentPerformance {
  id                  String   @id @default(uuid())
  agentId             String
  agent               Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  month               DateTime // First day of the month
  leadsReceived       Int      @default(0)
  leadsConverted      Int      @default(0)
  propertiesListed    Int      @default(0)
  propertiesSold      Int      @default(0)
  totalSalesValue     Float    @default(0)
  averageResponseTime Int? // in minutes
  rating              Float? // average rating for the month
  createdAt           DateTime @default(now())

  @@unique([agentId, month])
  @@index([month])
}

// ==================== MESSAGES ====================

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  subject     String?
  content     String
  attachments Json? // File attachments
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, read])
  @@index([senderId])
  @@index([propertyId])
}
