        "@types/chai": "^4.3.0",
        "@types/mocha": "^10.0.0",
        "@types/node": "^20.0.0",
        "chai": "^4.3.0",
        "ethers": "^6.9.0",
        "hardhat": "^2.19.0",
        "hardhat-gas-reporter": "^1.0.10",
